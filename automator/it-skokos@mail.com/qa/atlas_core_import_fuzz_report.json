```python
import requests, sys, os

TARGET_URL = os.getenv("ATLAS_IMPORT_URL", "https://internal.staging.skokos.local/api/v1/atlas-core/import")
HEADERS = {"Authorization": "Bearer REDACTED_QA_TOKEN", "Content-Type": "application/json"}

# Payload permutations derived from Company Document boundaries
PAYLOADS = [
    {"tenant_id": "../etc/passwd", "records": []},
    {"tenant_id": "1", "records": [{"name": "A" * 65536}]},
    {"tenant_id": "1", "records": [{"id": -1, "meta": "\x00\xFF"}]},
]

def run_fuzz():
    for idx, p in enumerate(PAYLOADS):
        res = requests.post(TARGET_URL, json=p, headers=HEADERS, timeout=5)
        assert res.status_code in [400, 422], f"Security alert on payload {idx}: {res.status_code}"

if __name__ == "__main__":
    run_fuzz()
```

