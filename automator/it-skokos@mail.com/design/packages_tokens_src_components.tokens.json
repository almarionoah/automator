          "focus": { "$value": "2px solid {color.brand.primary.500}", "$type": "border" },
          "error": { "$value": "1px solid {color.feedback.error.500}", "$type": "border" }
        },
        "radius": { "$value": "{radius.sm}", "$type": "dimension" },
        "height": {
          "saas": { "$value": "36px", "$type": "dimension" },
          "f2f": { "$value": "48px", "$type": "dimension" }
        }
      }
    },
    "card": {
      "surface": {
        "background": { "$value": "{color.neutral.0}", "$type": "color" },
        "border": { "$value": "1px solid {color.neutral.200}", "$type": "border" },
        "radius": { "$value": "{radius.lg}", "$type": "dimension" },
        "shadow": { "$value": "{elevation.low}", "$type": "shadow" },
        "padding": { "$value": "{spacing.lg}", "$type": "dimension" }
      }
