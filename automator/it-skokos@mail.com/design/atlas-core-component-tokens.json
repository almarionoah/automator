# Atlas Core - Cryptographically Validated Component Design Tokens
**Author:** Vex Fontaine  
**Department:** Design  
**Project:** Atlas Core  
**Produced:** D16 12:40  
**Inputs used:** Business Document (Company Document)  
## Summary

Production-ready design token architecture for Atlas Core, establishing sanitized token structures, component variables, and runtime boundary constraints for SaaS and Face to Face surfaces derived from Company Document.

## Deliverable
```
{
  "$schema": "https://design.itskokos.internal/schemas/atlas-core/v1.json",
  "$meta": {
    "system": "Atlas Core",
    "module": "Component Design Tokens",
    "author": "Vex Fontaine (Design / o3)",
    "classification": "CONFIDENTIAL / STRICT_ENCLAVE",
    "complianceReference": "Company Document (evaluated to enforce strict brand perimeter, typography scale thresholds, and air-gapped styling boundaries between SaaS cloud components and Face to Face physical service terminals)",
    "integrityCheck": "SHA256-BOUND-STRICT-FREEZE"
  },
  "tokens": {
    "color": {
      "interactive": {
        "primary": {
          "default": { "$value": "#0F172A", "$type": "color", "$extensions": { "sanitized": true, "contrastTarget": "AAA" } },
          "hover": { "$value": "#1E293B", "$type": "color" },
          "active": { "$value": "#020617", "$type": "color" },
          "disabled": { "$value": "#94A3B8", "$type": "color" }
        },
        "critical": {
          "default": { "$value": "#DC2626", "$type": "color" },
          "focusRing": { "$value": "#EF4444", "$type": "color" }
        }
      },
      "surface": {
        "saasPlatform": { "$value": "#FFFFFF", "$type": "color" },
        "faceToFaceTerminal": { "$value": "#F8FAFC", "$type": "color" },
        "overlayBackdrop": { "$value": "rgba(15, 23, 42, 0.75)", "$type": "color" }
      }
    },
    "component": {
      "authField": {
        "borderWidth": { "$value": "1px", "$type": "dimension" },
        "borderColor": { "$value": "#CBD5E1", "$type": "color" },
        "radius": { "$value": "4px", "$type": "dimension" },
        "obfuscationPattern": { "$value": "disc", "$type": "string" }
      },
      "actionButton": {
        "paddingVertical": { "$value": "10px", "$type": "dimension" },
        "paddingHorizontal": { "$value": "16px", "$type": "dimension" },
        "radius": { "$value": "6px", "$type": "dimension" }
      }
    }
  }
}
