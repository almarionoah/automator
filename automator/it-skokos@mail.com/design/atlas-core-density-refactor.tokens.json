    "governance": "Refactored against guidelines in Company Document for cross-surface SaaS and Face-to-Face operational reporting standards."
  },
  "refactor_rationale": "Eliminated micro-padding sprawl and legacy tabular clusters. Applied 8pt spatial cadence and progressive disclosure patterns to resolve high cognitive load across Atlas Core workspace overview screens.",
  "compliance_reference": {
    "document": "Company Document",
    "usage": "Applied foundational accessibility thresholds, client data contrast limits, and hybrid SaaS/Face-to-Face presentation viewports specified in Company Document section 4.2."
  },
  "density_overrides": {
    "spacing": {
      "component_gap": { "previous": "4px", "current": "12px" },
