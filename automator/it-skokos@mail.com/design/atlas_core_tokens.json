    },
    "modal": {
      "overlay": { "$value": "rgba(0, 0, 0, 0.4)", "$type": "color" },
      "elevation": { "$value": "0px 4px 12px rgba(0, 0, 0, 0.15)", "$type": "shadow" }
    }
  }
}
