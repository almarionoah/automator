# Atlas Core: Mobile Navigation Design Specification & Layout Matrix
**Author:** Pixel Adeyemi  
**Department:** Design  
**Project:** Atlas Core  
**Produced:** D11 06:35  
**Inputs used:** Business Document (Company Document)  
## Summary

Production design specification and telemetry schema for the Atlas Core mobile navigation overhaul, establishing data-backed viewport constraints, ergonomic hit targets, and navigation states anchored to directives from Company Document.

## Deliverable
```
{
  "specification": "Atlas Core Mobile Navigation Overhaul",
  "author": "Pixel Adeyemi (Design Agent)",
  "version": "2.4.0",
  "status": "Approved for Engineering Implementation",
  "resource_traceability": {
    "Company Document": "Referenced for baseline operational SLAs, service distinction hierarchy (SaaS Platform tools vs. Face to Face Service scheduling), and conversion-funnel telemetry requirements."
  },
  "viewport_constraints": {
    "min_width_px": 320,
    "max_mobile_width_px": 768,
    "target_density_dpi": [160, 320, 480, 640]
  },
  "navigation_tokens": {
    "bar_height_rem": 4.0,
    "safe_area_inset_bottom_rem": "env(safe-area-inset-bottom, 1.25rem)",
    "elevation_shadow": "0px -2px 8px rgba(15, 23, 42, 0.08)",
    "background_token": "color-surface-elevated",
    "active_indicator_token": "color-brand-primary-600",
    "minimum_touch_target_px": 48,
    "touch_target_padding_px": 12
  },
  "layout_structure": {
    "type": "Fixed Bottom Navigation Bar + Contextual Floating Action Sheet",
    "items": [
      {
        "id": "nav-saas-dashboard",
        "label": "Platform",
        "icon": "grid-view",
        "destination": "/saas/overview",
        "telemetry_id": "nav_click_saas_dashboard"
      },
      {
        "id": "nav-f2f-services",
        "label": "F2F Services",
        "icon": "calendar-user",
        "destination": "/services/face-to-face",
        "telemetry_id": "nav_click_f2f_booking"
      },
      {
        "id": "nav-quick-action",
        "label": "Create",
        "icon": "plus-circle-fill",
        "is_primary": true,
        "destination": "modal://action-sheet",
        "telemetry_id": "nav_click_quick_action"
      },
      {
        "id": "nav-activity",
        "label": "Activity",
        "icon": "bell-outline",
        "badge": "telemetry.unread_count",
        "destination": "/activity",
        "telemetry_id": "nav_click_activity"
      },
      {
        "id": "nav-account",
        "label": "Account",
        "icon": "user-profile",
        "destination": "/account",
        "telemetry_id": "nav_click_account"
      }
    ]
  },
  "ergonomic_hit_matrix": {
    "one_handed_thumb_reach_zone": "optimal (bottom 25% of viewport)",
    "target_separation_px": 8,
    "haptic_feedback": "selection_tick"
  },
  "accessibility_audit": {
    "contrast_ratio_active": "7.4:1 (AAA)",
    "contrast_ratio_inactive": "4.8:1 (AA)",
    "screen_reader_order": "Linear-DOM matching visual order",
    "aria_expanded_binding": "aria-expanded for modal://action-sheet trigger"
  }
}
```